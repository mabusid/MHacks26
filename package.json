{
  "name": "mission-control",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:phase1": "pnpm --filter @mission-control/server exec tsx ../scripts/checks/phase1.ts",
    "check:phase3": "pnpm --filter @mission-control/server exec tsx ../scripts/checks/phase3.ts",
    "check:phase4": "pnpm --filter @mission-control/server exec tsx ../scripts/checks/phase4.ts",
    "check:phase5": "pnpm --filter @mission-control/server exec tsx ../scripts/checks/phase5.ts",
    "check:phase6": "pnpm --filter @mission-control/server exec tsx ../scripts/checks/phase6.ts",
    "check:phase7": "pnpm --filter @mission-control/server exec tsx ../scripts/checks/phase7.ts",
    "build:pack": "RESEARCH_PACE_MS=0 pnpm --filter @mission-control/server exec tsx src/research/buildPack.ts",
    "check:phase8": "pnpm --filter @mission-control/server exec tsx ../scripts/checks/phase8.ts",
    "check:phase9": "pnpm --filter @mission-control/server exec tsx ../scripts/checks/phase9.ts"
  }
}
